#!/usr/bin/env python3
"""ProjectDock - a fast, keyboard-first project launcher for Omarchy.

Works directly from the repository; no installation required.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from projectdock.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
